  {
    "id": "pit_ends_attempt",
    "description": "Falling into the pit ends the attempt.",
    "violation": {
      "after": [
        {
          "and": [
            {
              ">=": [
                {
                  "var": "PlayerLocation.X"
                },
                2350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.X"
                },
                2650
              ]
            },
            {
              ">=": [
                {
                  "var": "PlayerLocation.Y"
                },
                350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.Y"
                },
                650
              ]
            },
            {
              "<": [
                {
                  "var": "PlayerLocation.Z"
                },
                {
                  "var": "LastFloorLocation.Z"
                }
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "PawnAlive"
            },
            true
          ]
        }
      ]
    }
  },
