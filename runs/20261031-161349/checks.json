[
  {
    "id": "side_door_opens",
    "description": "The side door opens when interacted with from nearby.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.SideDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.SideDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "side_door_no_spontaneous_open",
    "description": "The side door never opens without a nearby interact.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SideDoor"
              },
              "closed"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SideDoor"
              },
              "open"
            ]
          },
          {
            "not": {
              "and": [
                {
                  "did": "interact"
                },
                {
                  "<": [
                    {
                      "dist": [
                        "PlayerLocation",
                        "ActorLocations.SideDoor"
                      ]
                    },
                    150
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  {
    "id": "exit_opens_with_coin",
    "description": "With the gold coin, interacting with the exit door opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GoldCoin"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.ExitDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.ExitDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "exit_stays_closed_without_coin",
    "description": "The exit door stays closed without the gold coin.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.ExitDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "silver_worth_two",
    "description": "The silver coin adds 2 to the inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
  {
