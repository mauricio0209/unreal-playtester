  {
    "id": "coin_worth_one",
    "description": "Coin adds exactly 1 to inventory when collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.Coin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              1
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gem_bundle_worth_three",
    "description": "GemBundle adds exactly 3 to inventory when collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GemBundle"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GemBundle"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              3
            ]
          }
        ]
      }
    }
  },
  {
    "id": "loot_never_disappears_without_inventory",
    "description": "Loot never disappears without being added to inventory.",
    "violation": {
      "ever": {
        "or": [
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.Coin"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.Coin"
                  },
                  null
                ]
              },
              {
                "<=": [
                  {
                    "-": [
                      {
                        "var": "InventoryCount"
                      },
                      {
                        "prev": "InventoryCount"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.GemBundle"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.GemBundle"
                  },
                  null
                ]
              },
              {
                "<=": [
                  {
                    "-": [
                      {
                        "var": "InventoryCount"
                      },
                      {
                        "prev": "InventoryCount"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          }
        ]
      }
    }
  }
