[
  {
    "id": "green_door_starts_closed",
    "description": "GreenDoor starts closed and locked.",
    "violation": {
      "!=": [
        {
          "first": "ActorStates.GreenDoor"
        },
        "closed"
      ]
    }
  },
  {
    "id": "red_door_starts_closed",
    "description": "RedDoor starts closed and locked.",
