  {
    "id": "coin_worth_one",
    "description": "A coin is worth 1.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.Coin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              1
            ]
          }
        ]
      }
    }
  },
