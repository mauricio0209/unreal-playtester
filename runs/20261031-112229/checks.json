[
  {
    "id": "doors_start_closed",
    "description": "Every door starts closed.",
    "violation": {
      "final": {
        "or": [
          {
            "!=": [
              {
                "first": "ActorStates.GreenDoor"
              },
              "closed"
            ]
          },
          {
            "!=": [
              {
                "first": "ActorStates.RedDoor"
              },
              "closed"
            ]
          },
          {
            "!=": [
              {
                "first": "ActorStates.BlueDoor"
              },
              "closed"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "door_needs_own_key",
    "description": "A door opens only if the player is carrying the key of the same color.",
    "violation": {
      "ever": {
        "or": [
          {
            "and": [
              {
                "==": [
                  {
                    "var": "ActorStates.GreenDoor"
                  },
                  "open"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.GreenKey"
                  },
                  "present"
                ]
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "var": "ActorStates.RedDoor"
                  },
                  "open"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.RedKey"
                  },
                  "present"
                ]
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "var": "ActorStates.BlueDoor"
                  },
                  "open"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.BlueKey"
                  },
                  "present"
                ]
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "green_opens_with_key",
    "description": "Interacting next to the green door while carrying the green key opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GreenKey"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.GreenDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
