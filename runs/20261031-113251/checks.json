  {
    "id": "coin_worth_one",
    "description": "Coin adds 1 to inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.Coin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              1
            ]
          }
        ]
      }
    }
  },
  {
