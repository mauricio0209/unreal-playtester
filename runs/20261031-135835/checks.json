  {
    "id": "keys_no_inventory",
    "description": "Keys go on the key ring and do not change the inventory count.",
    "violation": {
      "or": [
        {
          "ever": {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.GreenKey"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.GreenKey"
                  },
                  null
                ]
              },
              {
                "!=": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              }
            ]
          }
        },
        {
          "ever": {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.RedKey"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.RedKey"
                  },
                  null
                ]
              },
              {
                "!=": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              }
            ]
          }
        },
        {
          "ever": {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.BlueKey"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.BlueKey"
                  },
                  null
                ]
              },
              {
                "!=": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
