  },
  {
    "id": "coin_worth_one",
    "description": "Collecting the coin adds 1 to inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.Coin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              1
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gem_worth_three",
    "description": "Collecting the gem bundle adds 3 to inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GemBundle"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GemBundle"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              3
            ]
          }
        ]
      }
    }
  },
  {
    "id": "inventory_needs_loot",
    "description": "Inventory count increases only when loot is collected.",
    "violation": {
      "ever": {
        "and": [
          {
            ">": [
              {
                "var": "InventoryCount"
              },
              {
                "prev": "InventoryCount"
              }
            ]
          },
          {
            "not": {
              "or": [
                {
                  "and": [
                    {
                      "==": [
                        {
                          "prev": "ActorStates.Coin"
                        },
                        "present"
                      ]
                    },
                    {
                      "==": [
                        {
                          "var": "ActorStates.Coin"
                        },
                        null
                      ]
                    }
                  ]
                },
                {
                  "and": [
                    {
                      "==": [
                        {
                          "prev": "ActorStates.GemBundle"
                        },
                        "present"
                      ]
                    },
                    {
                      "==": [
                        {
                          "var": "ActorStates.GemBundle"
                        },
                        null
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  {
    "id": "keys_not_loot",
    "description": "Picking up keys does not change inventory count.",
    "violation": {
      "ever": {
        "and": [
          {
            "or": [
              {
                "and": [
                  {
                    "==": [
                      {
                        "prev": "ActorStates.GreenKey"
                      },
                      "present"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "ActorStates.GreenKey"
                      },
                      null
                    ]
                  }
                ]
              },
              {
                "and": [
                  {
                    "==": [
                      {
                        "prev": "ActorStates.RedKey"
                      },
                      "present"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "ActorStates.RedKey"
                      },
                      null
                    ]
                  }
                ]
              },
              {
                "and": [
                  {
                    "==": [
                      {
                        "prev": "ActorStates.BlueKey"
                      },
                      "present"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "ActorStates.BlueKey"
                      },
                      null
                    ]
                  }
                ]
              }
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              0
            ]
          }
        ]
      }
    }
  }
]