[
  {
    "id": "green_door_needs_key",
    "description": "Green door opens only if green key is carried.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.GreenDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GreenKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "red_door_needs_key",
    "description": "Red door opens only if red key is carried.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.RedDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.RedKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "blue_door_needs_key",
    "description": "Blue door opens only if blue key is carried.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.BlueDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.BlueKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "green_door_opens_with_key",
    "description": "Interacting next to green door while carrying green key opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GreenKey"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.GreenDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "red_door_opens_with_key",
    "description": "Interacting next to red door while carrying red key opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.RedKey"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.RedDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.RedDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "blue_door_opens_with_key",
