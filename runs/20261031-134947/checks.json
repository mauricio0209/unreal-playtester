              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "<=": [
              {
                "var": "InventoryCount"
              },
              {
                "prev": "InventoryCount"
              }
            ]
          }
        ]
      }
    }
  },
