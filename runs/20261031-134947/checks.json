      }
    }
  },
  {
    "id": "blue_needs_key",
    "description": "The blue door stays locked until the blue key is picked up.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.BlueDoor"
