              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GemBundle"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              3
            ]
          }
        ]
      }
    }
  },
  {
    "id": "coin_never_vanishes",
