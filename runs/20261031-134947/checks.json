[
  {
    "id": "doors_start_closed",
    "description": "Every door starts closed and locked.",
    "violation": {
      "or": [
        {
          "!=": [
            {
              "first": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.RedDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.BlueDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "green_needs_key",
    "description": "The green door stays locked until the green key is picked up.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.GreenDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GreenKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "red_needs_key",
    "description": "The red door stays locked until the red key is picked up.",
