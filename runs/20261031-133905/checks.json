[
  {
    "id": "doors_start_closed",
    "description": "All three doors start closed and locked.",
    "violation": {
      "or": [
        {
          "!=": [
            {
              "first": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.RedDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.BlueDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "green_door_needs_green_key",
    "description": "Green door cannot open while GreenKey is still present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.GreenDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GreenKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "red_door_needs_red_key",
    "description": "Red door cannot open while RedKey is still present.",
    "violation": {
