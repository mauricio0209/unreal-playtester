        "and": [
          {
            "==": [
              {
                "var": "ActorStates.RedDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.RedKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "blue_door_needs_blue_key",
    "description": "Blue door cannot open while BlueKey is still present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.BlueDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.BlueKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "green_door_opens_with_green_key",
    "description": "Interacting with GreenDoor while carrying GreenKey must open it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GreenKey"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.GreenDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "red_door_opens_with_red_key",
