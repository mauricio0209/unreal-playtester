            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "<=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              0
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gem_bundle_never_vanishes",
