[
  {
    "id": "side_door_opens_when_used",
    "description": "The side door is never locked: standing next to it and interacting opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.SideDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.SideDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "exit_door_needs_gold_coin",
    "description": "The exit door opens only for a player carrying the gold coin.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.ExitDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "exit_door_opens_with_gold_coin",
    "description": "With the gold coin, interacting with the exit door opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GoldCoin"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.ExitDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.ExitDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "silver_coin_worth_two",
    "description": "The silver coin is worth 2 when collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gold_coin_worth_five",
    "description": "The gold coin is worth 5 when collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GoldCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              5
            ]
          }
        ]
      }
    }
  },
  {
    "id": "no_death_outside_pit",
    "description": "The player must never die or fall below KillZ outside the pit.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "PawnAlive"
              },
              false
            ]
          },
          {
            "not": {
              "and": [
                {
                  ">=": [
                    {
                      "var": "PlayerLocation.X"
                    },
                    2350
                  ]
                },
                {
                  "<=": [
                    {
                      "var": "PlayerLocation.X"
                    },
                    2650
                  ]
                },
                {
                  ">=": [
                    {
                      "var": "PlayerLocation.Y"
                    },
                    350
                  ]
                },
                {
                  "<=": [
                    {
                      "var": "PlayerLocation.Y"
                    },
                    650
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  {
    "id": "no_fall_through_floor_outside_pit",
    "description": "Outside the pit the floor is solid: the player must never end up below the floor.",
    "violation": {
      "ever": {
        "and": [
          {
            "<": [
              {
                "var": "PlayerLocation.Z"
              },
              0
            ]
          },
          {
            "not": {
              "and": [
                {
                  ">=": [
                    {
                      "var": "PlayerLocation.X"
                    },
                    2350
                  ]
                },
                {
                  "<=": [
                    {
                      "var": "PlayerLocation.X"
                    },
                    2650
                  ]
                },
                {
                  ">=": [
                    {
                      "var": "PlayerLocation.Y"
                    },
                    350
                  ]
                },
                {
                  "<=": [
                    {
                      "var": "PlayerLocation.Y"
                    },
                    650
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
]