  {
    "id": "coin_worth_one",
    "description": "Coin adds 1 to inventory when collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.Coin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              1
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gem_bundle_worth_three",
