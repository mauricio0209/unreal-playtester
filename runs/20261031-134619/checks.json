[
  {
    "id": "doors_start_closed_green",
    "description": "GreenDoor starts closed and locked.",
    "violation": {
      "not": {
        "==": [
          {
            "first": "ActorStates.GreenDoor"
          },
          "closed"
        ]
      }
    }
  },
  {
    "id": "doors_start_closed_red",
