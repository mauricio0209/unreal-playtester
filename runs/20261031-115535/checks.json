            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.RedKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "blue_door_needs_key",
    "description": "Blue door must not be open while blue key is still present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.BlueDoor"
