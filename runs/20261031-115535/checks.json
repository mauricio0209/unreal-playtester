            ]
          }
        ]
      }
    }
  },
  {
    "id": "green_door_opens_with_key",
    "description": "Interacting with green door up close while carrying green key must open it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GreenKey"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.GreenDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
