  {
    "id": "silver_walkover",
    "description": "The silver coin is collected only by walking over it.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "or": [
              {
                ">": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  {
                    "+": [
                      {
                        "first": "ActorLocations.SilverCoin.X"
                      },
                      150
                    ]
                  }
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  {
                    "-": [
                      {
                        "first": "ActorLocations.SilverCoin.X"
                      },
                      150
                    ]
                  }
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  {
                    "+": [
                      {
                        "first": "ActorLocations.SilverCoin.Y"
                      },
                      150
                    ]
                  }
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  {
                    "-": [
                      {
                        "first": "ActorLocations.SilverCoin.Y"
                      },
                      150
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
