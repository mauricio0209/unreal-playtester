        },
        {
          "==": [
            {
              "var": "ActorStates.ExitDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "silver_worth_two",
    "description": "Collecting the silver coin adds exactly 2 to the inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
  {
