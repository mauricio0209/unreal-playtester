  {
    "id": "pit_ends_attempt",
    "description": "Falling into the pit from x 2350 to 2650 and y 350 to 650 ends the attempt.",
    "violation": {
      "and": [
        {
          "ever": {
            "and": [
              {
                ">=": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2350
                ]
              },
              {
                "<=": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2650
                ]
              },
              {
                ">=": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  350
                ]
              },
              {
                "<=": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  650
                ]
              }
            ]
          }
        },
        {
          "final": {
            "==": [
              {
                "var": "PawnAlive"
              },
              true
            ]
          }
        }
      ]
    }
  },
