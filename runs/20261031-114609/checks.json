            ]
          }
        ]
      }
    }
  },
  {
    "id": "green_door_opens_with_key",
    "description": "Interacting next to the green door while carrying the green key opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GreenKey"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.GreenDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "red_door_opens_with_key",
