[
  {
    "id": "doors_start_closed",
    "description": "Every door starts closed and locked.",
    "violation": {
      "or": [
        {
          "!=": [
            {
              "first": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.RedDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.BlueDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "green_door_needs_key",
    "description": "The green door is never open while the green key is still present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.GreenDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GreenKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "red_door_needs_key",
    "description": "The red door is never open while the red key is still present.",
    "violation": {
