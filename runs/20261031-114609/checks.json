        "and": [
          {
            "==": [
              {
                "var": "ActorStates.RedDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.RedKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "blue_door_needs_key",
    "description": "The blue door is never open while the blue key is still present.",
    "violation": {
