  {
    "id": "green_key_not_loot",
    "description": "Picking up the green key does not change the inventory count.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GreenKey"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GreenKey"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              0
            ]
          }
        ]
      }
    }
  },
