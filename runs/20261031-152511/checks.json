[
  {
    "id": "side_door_opens_with_interact",
    "description": "The side door opens when the player stands next to it and interacts, with or without inventory.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.SideDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.SideDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "exit_door_stays_locked_without_gold",
    "description": "The exit door stays locked until the gold coin is picked up.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.ExitDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "exit_door_opens_with_gold",
    "description": "With the gold coin, interacting with the exit door opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GoldCoin"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.ExitDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.ExitDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "silver_coin_worth_two",
    "description": "The silver coin adds 2 to the inventory count.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gold_coin_worth_five",
    "description": "The gold coin adds 5 to the inventory count.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GoldCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              5
            ]
          }
        ]
      }
    }
  },
  {
    "id": "pit_ends_attempt",
    "description": "Falling into the pit (x 2350-2650, y 350-650) ends the attempt.",
    "violation": {
      "after": [
        {
          "and": [
            {
              ">=": [
                {
                  "var": "PlayerLocation.X"
                },
                2350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.X"
                },
                2650
              ]
            },
            {
              ">=": [
                {
                  "var": "PlayerLocation.Y"
                },
                350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.Y"
                },
                650
              ]
            },
            {
              "<": [
                {
                  "var": "PlayerLocation.Z"
                },
                0
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "PawnAlive"
            },
            true
          ]
        }
      ]
    }
  },
  {
    "id": "no_death_outside_pit",
    "description": "The player must never die outside the pit (x 2350-2650, y 350-650).",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "PawnAlive"
              },
              false
            ]
          },
          {
            "or": [
              {
                "<": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2650
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  650
                ]
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "no_fall_below_floor_outside_pit",
    "description": "The player must never end up below the floor outside the pit.",
    "violation": {
      "ever": {
        "and": [
          {
            "<": [
              {
                "var": "PlayerLocation.Z"
              },
              0
            ]
          },
          {
            "or": [
              {
                "<": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2650
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  650
                ]
              }
            ]
          }
        ]
      }
    }
  }
]