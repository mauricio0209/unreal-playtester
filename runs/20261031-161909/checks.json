[
  {
    "id": "side_door_opens_empty",
    "description": "Standing next to the side door and interacting with empty pockets opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.SideDoor"
                },
                "closed"
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.SideDoor"
                  ]
                },
                150
              ]
            },
            {
              "==": [
                {
                  "var": "InventoryCount"
                },
                0
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.SideDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
