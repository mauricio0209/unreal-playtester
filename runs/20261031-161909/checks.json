  {
    "id": "inventory_only_from_coins",
    "description": "Inventory changes only when a coin is collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "!=": [
              {
                "prev": "InventoryCount"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              0
            ]
          },
          {
            "not": {
              "and": [
                {
                  "==": [
                    {
                      "prev": "ActorStates.SilverCoin"
                    },
                    "present"
                  ]
                },
                {
                  "==": [
                    {
                      "var": "ActorStates.SilverCoin"
                    },
                    null
                  ]
                }
              ]
            }
          },
          {
            "not": {
              "and": [
                {
                  "==": [
                    {
                      "prev": "ActorStates.GoldCoin"
                    },
                    "present"
                  ]
                },
                {
                  "==": [
                    {
                      "var": "ActorStates.GoldCoin"
                    },
                    null
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  {
    "id": "no_death_outside_pit",
    "description": "The player never dies outside the pit.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "PawnAlive"
              },
              false
            ]
          },
          {
            "or": [
              {
                "<": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2650
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  350
                ]
              },
              {
                ">": [
                  {
