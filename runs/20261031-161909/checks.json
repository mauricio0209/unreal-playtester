  {
    "id": "silver_worth_two",
    "description": "The silver coin adds 2 to the inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
