  {
    "id": "coin_worth_one",
    "description": "A coin adds 1 to the inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.Coin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.Coin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              1
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gem_worth_three",
    "description": "A gem bundle adds 3 to the inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GemBundle"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GemBundle"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              3
            ]
          }
        ]
      }
    }
  },
  {
    "id": "inventory_only_from_loot",
    "description": "Inventory count only increases when loot is collected.",
    "violation": {
      "ever": {
        "and": [
          {
            ">": [
              {
                "var": "InventoryCount"
              },
              {
                "prev": "InventoryCount"
              }
            ]
          },
          {
            "not": {
              "or": [
                {
                  "and": [
                    {
                      "==": [
                        {
                          "prev": "ActorStates.Coin"
                        },
                        "present"
                      ]
                    },
                    {
                      "==": [
                        {
                          "var": "ActorStates.Coin"
                        },
                        null
                      ]
                    }
                  ]
                },
                {
                  "and": [
                    {
                      "==": [
                        {
                          "prev": "ActorStates.GemBundle"
                        },
                        "present"
                      ]
                    },
                    {
                      "==": [
                        {
                          "var": "ActorStates.GemBundle"
                        },
                        null
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
