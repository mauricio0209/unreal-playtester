[
  {
    "id": "side_door_opens_when_interacted",
    "description": "The side door is never locked: interacting next to it opens it with or without items.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.SideDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.SideDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "exit_door_stays_locked_without_gold",
    "description": "The exit door opens only for a player carrying the gold coin; without it the door stays closed.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.ExitDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "exit_door_opens_with_gold",
    "description": "With the gold coin, interacting with the exit door up close opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GoldCoin"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.ExitDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.ExitDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "silver_coin_worth_two",
    "description": "The silver coin is worth 2 and adds 2 to inventory when collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gold_coin_worth_five",
    "description": "The gold coin is worth 5 and adds 5 to inventory when collected.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GoldCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              5
            ]
          }
        ]
      }
    }
  },
  {
    "id": "floor_solid_outside_pit",
    "description": "Outside the pit (x 2350-2650 y 350-650) the floor is solid: the player must never die or fall below the floor.",
    "violation": {
      "ever": {
        "and": [
          {
            "or": [
              {
                "<": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2650
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  650
                ]
              }
            ]
          },
          {
            "or": [
              {
                "==": [
                  {
                    "var": "PawnAlive"
                  },
                  false
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Z"
                  },
                  0
                ]
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "pit_ends_attempt",
    "description": "Falling into the pit from x 2350 to 2650 and y 350 to 650 is intended and ends the attempt.",
    "violation": {
      "after": [
        {
          "and": [
            {
              ">=": [
                {
                  "var": "PlayerLocation.X"
                },
                2350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.X"
                },
                2650
              ]
            },
            {
              ">=": [
                {
                  "var": "PlayerLocation.Y"
                },
                350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.Y"
                },
                650
              ]
            },
            {
              "<": [
                {
                  "var": "PlayerLocation.Z"
                },
                20
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "PawnAlive"
            },
            true
          ]
        }
      ]
    }
  }
]