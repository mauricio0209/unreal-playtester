[
  {
    "id": "doors_start_closed",
    "description": "All doors start closed.",
    "violation": {
      "or": [
        {
          "!=": [
            {
              "first": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.RedDoor"
            },
            "closed"
          ]
        },
        {
          "!=": [
            {
              "first": "ActorStates.BlueDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "green_needs_key",
    "description": "Green door stays shut with key present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.GreenDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GreenKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "red_needs_key",
    "description": "Red door stays shut with key present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.RedDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.RedKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "blue_needs_key",
    "description": "Blue door stays shut with key present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.BlueDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.BlueKey"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "green_opens",
    "description": "Green door opens with green key.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GreenKey"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.GreenDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.GreenDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "red_opens",
    "description": "Red door opens with red key.",
