          ]
        }
      ]
    }
  },
  {
    "id": "green_key_free",
    "description": "Green key adds no inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GreenKey"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GreenKey"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              0
            ]
          }
        ]
      }
    }
  },
  {
