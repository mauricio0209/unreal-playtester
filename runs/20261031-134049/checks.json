  {
    "id": "loot_only",
    "description": "Inventory rises only on loot pickup.",
    "violation": {
      "ever": {
        "and": [
          {
            ">": [
              {
                "var": "InventoryCount"
              },
              {
                "prev": "InventoryCount"
              }
            ]
          },
          {
            "not": {
              "or": [
                {
                  "and": [
                    {
                      "==": [
                        {
                          "prev": "ActorStates.Coin"
                        },
                        "present"
                      ]
                    },
                    {
                      "==": [
                        {
                          "var": "ActorStates.Coin"
                        },
                        null
                      ]
                    }
                  ]
                },
                {
                  "and": [
                    {
                      "==": [
                        {
                          "prev": "ActorStates.GemBundle"
                        },
                        "present"
                      ]
                    },
                    {
                      "==": [
                        {
                          "var": "ActorStates.GemBundle"
                        },
                        null
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
