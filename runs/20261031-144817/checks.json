[
  {
    "id": "side_opens",
    "description": "Side door opens when interacting next to it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.SideDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.SideDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "exit_needs_coin",
    "description": "Exit door opens only for player carrying gold coin.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.ExitDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "exit_opens",
    "description": "Exit door opens with gold coin on interact next to it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GoldCoin"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.ExitDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.ExitDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "silver_two",
    "description": "Silver coin adds exactly 2 to inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gold_five",
    "description": "Gold coin adds exactly 5 to inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GoldCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              5
            ]
          }
        ]
      }
    }
  },
  {
    "id": "die_outside",
    "description": "Player must never die outside the pit.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "PawnAlive"
              },
              false
            ]
          },
          {
            "or": [
              {
                "<": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2650
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  650
                ]
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "below_outside",
