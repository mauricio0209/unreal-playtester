              {
                "<": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.X"
                  },
                  2650
                ]
              },
              {
                "<": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  350
                ]
              },
              {
                ">": [
                  {
                    "var": "PlayerLocation.Y"
                  },
                  650
                ]
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "pit_ends",
    "description": "Falling into pit ends the attempt.",
    "violation": {
      "after": [
        {
          "and": [
            {
              ">=": [
                {
                  "var": "PlayerLocation.X"
                },
                2350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.X"
                },
                2650
              ]
            },
            {
              ">=": [
                {
                  "var": "PlayerLocation.Y"
                },
                350
              ]
            },
            {
              "<=": [
                {
                  "var": "PlayerLocation.Y"
                },
                650
              ]
            },
            {
              "<": [
                {
                  "var": "PlayerLocation.Z"
                },
                0
              ]
