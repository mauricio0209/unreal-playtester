[
  {
    "id": "side_door_opens_on_interact",
    "description": "Interacting with the side door up close opens it regardless of inventory.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.SideDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.SideDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "side_door_stays_closed_without_interact",
    "description": "The side door must not open without an interact action.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.SideDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "prev": "ActorStates.SideDoor"
              },
              "closed"
            ]
          },
          {
            "not": {
              "did": "interact"
            }
          }
        ]
      }
    }
  },
  {
    "id": "exit_door_requires_gold_coin",
    "description": "The exit door stays closed while the gold coin is still present.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "var": "ActorStates.ExitDoor"
              },
              "open"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              "present"
            ]
          }
        ]
      }
    }
  },
  {
    "id": "exit_door_opens_with_gold_coin",
    "description": "With the gold coin collected interacting with the exit door up close opens it.",
    "violation": {
      "after": [
        {
          "and": [
            {
              "did": "interact"
            },
            {
              "==": [
                {
                  "var": "ActorStates.GoldCoin"
                },
                null
              ]
            },
            {
              "<": [
                {
                  "dist": [
                    "PlayerLocation",
                    "ActorLocations.ExitDoor"
                  ]
                },
                150
              ]
            }
          ]
        },
        {
          "==": [
            {
              "var": "ActorStates.ExitDoor"
            },
            "closed"
          ]
        }
      ]
    }
  },
  {
    "id": "silver_coin_worth_two",
    "description": "Collecting the silver coin adds exactly 2 to inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.SilverCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.SilverCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    }
  },
  {
    "id": "gold_coin_worth_five",
    "description": "Collecting the gold coin adds exactly 5 to inventory.",
    "violation": {
      "ever": {
        "and": [
          {
            "==": [
              {
                "prev": "ActorStates.GoldCoin"
              },
              "present"
            ]
          },
          {
            "==": [
              {
                "var": "ActorStates.GoldCoin"
              },
              null
            ]
          },
          {
            "!=": [
              {
                "-": [
                  {
                    "var": "InventoryCount"
                  },
                  {
                    "prev": "InventoryCount"
                  }
                ]
              },
              5
            ]
          }
        ]
      }
    }
  }
]