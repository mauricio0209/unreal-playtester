  {
    "id": "door_needs_own_key",
    "description": "A door opens only if the player is carrying the key of the same color; a key opens only its own color.",
    "violation": {
      "ever": {
        "or": [
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.GreenDoor"
                  },
                  "closed"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.GreenDoor"
                  },
                  "open"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.GreenKey"
                  },
                  "present"
                ]
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.RedDoor"
                  },
                  "closed"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.RedDoor"
                  },
                  "open"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.RedKey"
                  },
                  "present"
                ]
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.BlueDoor"
                  },
                  "closed"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.BlueDoor"
                  },
                  "open"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.BlueKey"
                  },
                  "present"
                ]
              }
            ]
          }
        ]
      }
    }
  },
