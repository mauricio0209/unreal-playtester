  {
    "id": "key_not_loot",
    "description": "Keys are not loot and do not change the inventory count.",
    "violation": {
      "ever": {
        "or": [
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.GreenKey"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.GreenKey"
                  },
                  null
                ]
              },
              {
                "!=": [
                  {
                    "-": [
                      {
                        "var": "InventoryCount"
                      },
                      {
                        "prev": "InventoryCount"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.RedKey"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.RedKey"
                  },
                  null
                ]
              },
              {
                "!=": [
                  {
                    "-": [
                      {
                        "var": "InventoryCount"
                      },
                      {
                        "prev": "InventoryCount"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.BlueKey"
                  },
                  "present"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.BlueKey"
                  },
                  null
                ]
              },
              {
                "!=": [
                  {
                    "-": [
                      {
                        "var": "InventoryCount"
                      },
                      {
                        "prev": "InventoryCount"
                      }
                    ]
                  },
                  0
                ]
              }
            ]
          }
        ]
      }
    }
  },
