  {
    "id": "door_needs_interact_close",
    "description": "A door opens only when the player stands next to it and interacts with it.",
    "violation": {
      "ever": {
        "or": [
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.GreenDoor"
                  },
                  "closed"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.GreenDoor"
                  },
                  "open"
                ]
              },
              {
                "not": {
                  "and": [
                    {
                      "did": "interact"
                    },
                    {
                      "<": [
                        {
                          "dist": [
                            "PlayerLocation",
                            "ActorLocations.GreenDoor"
                          ]
                        },
                        150
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.RedDoor"
                  },
                  "closed"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.RedDoor"
                  },
                  "open"
                ]
              },
              {
                "not": {
                  "and": [
                    {
                      "did": "interact"
                    },
                    {
                      "<": [
                        {
                          "dist": [
                            "PlayerLocation",
                            "ActorLocations.RedDoor"
                          ]
                        },
                        150
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "and": [
              {
                "==": [
                  {
                    "prev": "ActorStates.BlueDoor"
                  },
                  "closed"
                ]
              },
              {
                "==": [
                  {
                    "var": "ActorStates.BlueDoor"
                  },
                  "open"
                ]
              },
              {
                "not": {
                  "and": [
                    {
                      "did": "interact"
                    },
                    {
                      "<": [
                        {
                          "dist": [
                            "PlayerLocation",
                            "ActorLocations.BlueDoor"
                          ]
                        },
                        150
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
